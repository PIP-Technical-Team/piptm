    {
      "id": "FW206kuzu7YUVQNGQp_hD",
      "type": "text",
      "x": -1.7970258670727617,
      "y": -1735.0295304308406,
      "width": 450.09600181222424,
      "height": 187.73328247070313,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8R",
      "roundness": null,
      "seed": 1163347443,
      "version": 86,
      "versionNonce": 1784397139,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782160210507,
      "link": null,
      "locked": false,
      "text": "1. Load pipdata YAML for the release via pipload::pip_read()\n2. Load UI spec YAML from inst/extdata/tm_variable_spec.yaml\n3. For each variable in the UI spec:\n   a. Derive tm_type from pipdata recode_type\n   b. Extract category mapping and n_categories from pipdata\n      (NULL for continuous variables)\n   c. Combine with ui_label, roles, stat_groups, flags from UI spec\n4. Produce a structured list — one entry per variable\n5. Serialize to JSON and save to variable_registry/{release}.json",
      "fontSize": 15.451298968782147,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Load pipdata YAML for the release via pipload::pip_read()\n2. Load UI spec YAML from inst/extdata/tm_variable_spec.yaml\n3. For each variable in the UI spec:\n   a. Derive tm_type from pipdata recode_type\n   b. Extract category mapping and n_categories from pipdata\n      (NULL for continuous variables)\n   c. Combine with ui_label, roles, stat_groups, flags from UI spec\n4. Produce a structured list — one entry per variable\n5. Serialize to JSON and save to variable_registry/{release}.json",
      "autoResize": true,
      "lineHeight": 1.35
    },
